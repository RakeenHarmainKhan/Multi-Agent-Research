ENVIRONMENT=development

# LLM (Azure OpenAI): use your own endpoint, key and deployment/model
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_CHAT_API_VERSION=

# Optional: your model's prices (USD per 1M tokens) to show cost estimates; leave blank for tokens only
LLM_INPUT_COST_PER_1M_TOKENS=
LLM_OUTPUT_COST_PER_1M_TOKENS=

# Web search (https://tavily.com)
TAVILY_API_KEY=

# Optional metadata-only traces; disabled by default
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

BACKEND_CORS_ORIGINS=["http://localhost:5173", "https://*.vercel.app", "https://*.onrender.com"]
